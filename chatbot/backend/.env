# AI Chatbot Backend Configuration
# Production Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS - GitHub Pages domain
CORS_ORIGIN=https://eulagitpro.github.io

# LLM Provider - OpenRouter (Free tier)
OPENROUTER_API_KEY=sk-or-v1-da2f1c4d8e9f7a5b3c2d1e0f9a8b7c6d
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat

# Database Configuration - MongoDB Atlas
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb+srv://erika_user:erika_secure_2024@cluster0.mongodb.net/erika_chatbot?retryWrites=true&w=majority

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
