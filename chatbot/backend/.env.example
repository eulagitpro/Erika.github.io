# AI Chatbot Backend Configuration
# Copy this file to .env and fill in your actual credentials

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Add your GitHub Pages domain
CORS_ORIGIN=https://eulagitpro.github.io

# LLM Provider (Choose one)
# For OpenRouter (free tier with free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat  # or meta-llama/llama-2-7b-chat, mistralai/mistral-7b-instruct

# For local Ollama (optional)
# OLLAMA_API_URL=http://localhost:11434
# LLM_MODEL=llama2

# Database Configuration
# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatbot?retryWrites=true&w=majority

# Alternative: Supabase PostgreSQL
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_KEY=your_supabase_anon_key
# DATABASE_TYPE=supabase

DATABASE_TYPE=mongodb

# Redis (optional, for rate limiting & caching)
REDIS_URL=redis://default:password@hostname:port

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Session Management
SESSION_SECRET=your_random_session_secret_change_this

# Vector Search (optional - for memory retrieval)
VECTOR_PROVIDER=none  # Options: none, openai, huggingface
VECTOR_MODEL=all-MiniLM-L6-v2
